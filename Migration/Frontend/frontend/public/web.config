<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- No URL Rewrite needed: IIS serves index.html for all 404s -->
    <!-- The 404.html script restores the original path via sessionStorage -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/CTSUI/404.html" responseMode="Redirect" />
    </httpErrors>

  </system.webServer>
</configuration>
